# Copy to production.auto.tfvars (DO NOT commit the real file — it contains secrets)
#
# Review plan carefully before applying to production:
#   terraform plan -var-file=production.auto.tfvars

project_name = "qualite-domicile"
environment  = "production"
aws_region   = "eu-west-3"

# --- RDS ----------------------------------------------------------------------
# Generate a strong password: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Store the real value in AWS Secrets Manager, not in this file.
db_password = "CHANGEME-strong-random-password-32char"

db_instance_class        = "db.t4g.medium"
db_allocated_storage     = 100
db_max_allocated_storage = 500
db_multi_az              = true    # mandatory in production (RPO/RTO targets)
db_backup_retention_days = 30

# --- Redis --------------------------------------------------------------------
redis_node_type          = "cache.t4g.small"
redis_num_cache_clusters = 2       # primary + replica, multi-AZ failover

# --- Tagging ------------------------------------------------------------------
extra_tags = {
  Owner        = "platform-team"
  CostCenter   = "engineering"
  HDSCompliant = "true"
  BackupPolicy = "6-year-retention"
}
