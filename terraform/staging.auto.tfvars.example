# Copy to staging.auto.tfvars (DO NOT commit the real file — it contains secrets)
#
# terraform plan  -var-file=staging.auto.tfvars
# terraform apply -var-file=staging.auto.tfvars

project_name = "qualite-domicile"
environment  = "staging"
aws_region   = "eu-west-3"

# --- RDS ----------------------------------------------------------------------
# Generate a strong password: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
db_password = "CHANGEME-strong-random-password-32char"

db_instance_class        = "db.t4g.small"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_multi_az              = false   # staging cost saving; set true for production
db_backup_retention_days = 7

# --- Redis --------------------------------------------------------------------
redis_node_type          = "cache.t4g.micro"
redis_num_cache_clusters = 2       # primary + 1 replica for HA

# --- Tagging ------------------------------------------------------------------
extra_tags = {
  Owner       = "platform-team"
  CostCenter  = "engineering"
}
