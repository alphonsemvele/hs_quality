includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes
        - tests

    level: 5

    # Allow Inertia's dynamic response props and Laravel's magic query methods.
    # (Replaces the removed checkMissingIterableValueType /
    # checkGenericClassInNonGenericObjectType options — PHPStan 2.x expresses
    # the same intent via these error-identifier ignores.)
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics

    # Exclude generated code
    excludePaths:
        - vendor
        - storage
        - bootstrap/cache
        - public
