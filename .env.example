APP_NAME="QualitéDomicile"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Local-only: bypass mandatory TOTP enrollment for privileged roles so the
# DevSeeder accounts can log in without going through 2FA setup. Production
# MUST keep this ON (default true). See config/auth.php:132.
REQUIRE_MFA_ENROLLMENT=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database: PostgreSQL 16 via docker-compose ────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qualite_domicile
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── Session / cache / queue: Redis 7 via docker-compose ──────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=qualite_domicile

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Broadcasting: Laravel Reverb ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── File storage: S3 (MinIO locally, AWS S3 in prod) ─────────────────────────
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@qualite-domicile.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Sanctum (mobile API tokens + Inertia stateful auth) ──────────────────────
# Comma-separated list of domains allowed to use cookie auth. Default covers
# localhost development; production should pin to your real domain(s).
SANCTUM_STATEFUL_DOMAINS=
# Optional prefix prepended to issued personal access tokens (defaults to
# none — set this when you need to scan logs/repos for leaked tokens).
SANCTUM_TOKEN_PREFIX=
# Persist the last-used timestamp on each token (helps audit, costs 1 write
# per request). Disable in extreme throughput environments only.
SANCTUM_TRACK_LAST_USED=true

# ─── Mobile API throttling ────────────────────────────────────────────────────
# Per-user request budget on /api/v1/* — the offline sync client pushes ~50
# operations per visit so 300/min covers a normal workday with margin.
MOBILE_API_RATE_LIMIT_PER_MINUTE=300

# ─── Audit trail (owen-it/laravel-auditing) ──────────────────────────────────
# Master switch for the audit subsystem. Keep ON in any environment that
# touches health data (HDS + RGPD Art 30 require persistent who-did-what).
AUDITING_ENABLED=true
# Audit operations executed from the artisan console (cron, queue workers,
# seeders). Recommended ON in production to capture system actions.
AUDITING_CONSOLE=true

# ─── Pennant feature flags ────────────────────────────────────────────────────
# Where flag state is persisted. `database` survives restarts and is the
# default. `array` is in-memory only and resets per request — useful in
# tests.
PENNANT_STORE=database

# ─── Circuit breaker (external service protection) ────────────────────────────
# Trip after N consecutive failures, cool down for `cooldown` seconds before
# allowing a probe call. Used by NotifyARSJob and any service marked with
# CircuitBreaker support.
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=60

# ─── Billing (Cashier + Stripe) ───────────────────────────────────────────────
# Stripe Price IDs for each tier. Leave blank in dev; populate from the
# Stripe dashboard for staging/production. Each value is a `price_…` slug.
BILLING_PRICE_ESSENTIAL=
BILLING_PRICE_PRO=
BILLING_PRICE_PREMIUM=
BILLING_DEFAULT_TIER=essential
BILLING_TRIAL_DAYS=90

# Stripe API keys — get them from https://dashboard.stripe.com/apikeys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── API documentation (Scramble OpenAPI generator) ──────────────────────────
API_VERSION=1.0.0

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Public DSN — not a secret, but rotate if you see signal poisoning.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
